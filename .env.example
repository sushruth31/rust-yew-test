# Optional. Copy to .env and load it before building:  set -a && . ./.env && set +a
#
# Base URL of the PokeAPI-compatible service the pokedex page reads from.
# Public API, no key required: https://pokeapi.co/docs/v2
# Unset, the build uses https://pokeapi.co/api/v2 — a clean clone needs no setup.
# Set it to point at a local mirror or a mock server to develop offline; build.rs
# rejects a value that is not an absolute http(s) url.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
