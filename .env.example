# Copy to .env, then load it before building:  set -a && . ./.env && set +a
#
# Base URL of the PokeAPI-compatible service the pokedex page reads from.
# Public API, no key required: https://pokeapi.co/docs/v2
# Point it at a local mirror or a mock server to develop offline.
# Validated by build.rs — an absent or non-http(s) value fails the build.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
